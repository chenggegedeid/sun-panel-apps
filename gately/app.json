{
  "appJsonVersion": "1.1",
  "author": "chenggegedeid",
  "version": "1.3.0",
  "entry": "main.js",
  "icon": "icon.png",
  "debug": false,
  "appInfo": {
    "appName": "$t:APP_NAME",
    "description": "$t:APP_DESCRIPTION",
    "networkDescription": "$t:NETWORK_DESCRIPTION"
  },
  "locales": {
    "zh-CN": "zh-CN.json",
    "en-US": "en-US.json"
  },
  "defaultLocale": "zh-CN",
  "permissions": [
    "dataNode",
    "network"
  ],
  "networkDomains": [
    "*"
  ],
  "dataNodes": {
    "gately": {
      "scope": "user",
      "isPublic": false
    }
  },
  "microAppId": "chenggegedeid-Gately",
  "apiVersion": "1.0.19",
  "components": {
    "pages": {
      "gately-config": {
        "type": "config",
        "background": "linear-gradient(160deg, #eef7f4 0%, #f4f6fb 100%)",
        "backgroundDark": "linear-gradient(160deg, #131a19 0%, #171a21 100%)",
        "headerTextColor": "#15171a",
        "headerTextColorDark": "#f2f2f7",
        "width": 760,
        "height": 820,
        "resize": true
      },
      "gately-main": {
        "type": "main",
        "background": "#0c1211",
        "backgroundDark": "#0c1211",
        "headerTextColor": "#e8eaf0",
        "headerTextColorDark": "#e8eaf0",
        "width": 1120,
        "height": 760,
        "showFullscreenBtn": true,
        "resize": true
      }
    },
    "widgets": {
      "gately-widget": {
        "configComponentName": "gately-config",
        "size": [
          "1x1",
          "1x2",
          "2x1",
          "2x2",
          "2x4",
          "4x4",
          "1xfull"
        ],
        "background": "transparent",
        "isModifyBackground": true,
        "widgetName": "$t:WIDGET_NAME",
        "widgetDescription": "$t:WIDGET_DESCRIPTION",
        "sort": 30
      }
    }
  }
}