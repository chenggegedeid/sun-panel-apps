{
  "appJsonVersion": "1.1",
  "author": "chenggegedeid",
  "version": "3.0.2",
  "entry": "main.js",
  "icon": "icon.png",
  "debug": false,
  "appInfo": {
    "appName": "$t:APP_NAME",
    "description": "$t:APP_DESCRIPTION",
    "networkDescription": "$t:NETWORK_DESCRIPTION"
  },
  "locales": {
    "zh-CN": "zh-CN.json",
    "en-US": "en-US.json"
  },
  "defaultLocale": "zh-CN",
  "permissions": [
    "dataNode",
    "network"
  ],
  "networkDomains": [
    "*"
  ],
  "dataNodes": {
    "music": {
      "scope": "user",
      "isPublic": false
    }
  },
  "microAppId": "chenggegedeid-Music",
  "apiVersion": "1.0.19",
  "components": {
    "pages": {
      "music-config": {
        "type": "config",
        "background": "linear-gradient(160deg, #eef2fb 0%, #f7f1f8 100%)",
        "backgroundDark": "linear-gradient(160deg, #1a1d26 0%, #241d29 100%)",
        "headerTextColor": "#15171a",
        "headerTextColorDark": "#f2f2f7",
        "width": 760,
        "height": 720,
        "resize": true
      },
      "music-main": {
        "type": "main",
        "background": "#0b0d12",
        "backgroundDark": "#0b0d12",
        "headerTextColor": "#e8eaf0",
        "headerTextColorDark": "#e8eaf0",
        "width": 1080,
        "height": 720,
        "showFullscreenBtn": true,
        "resize": true
      }
    },
    "widgets": {
      "music-widget": {
        "configComponentName": "music-config",
        "size": [
          "1x1",
          "1x2",
          "2x1",
          "2x2",
          "2x4",
          "4x4",
          "1xfull"
        ],
        "background": "transparent",
        "isModifyBackground": true,
        "widgetName": "$t:WIDGET_NAME",
        "widgetDescription": "$t:WIDGET_DESCRIPTION",
        "sort": 20
      }
    }
  }
}